# PostgreSQL connection string (Supabase)
# Use the Supabase SESSION pooler (port 5432) — required by Prisma 7 for both
# the runtime adapter and `prisma migrate`. Do NOT use the transaction pooler
# (port 6543): it breaks prepared statements with "prepared statement already
# exists" errors. Add sslmode=require in production.
# "postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require"
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# Public base URL of the app (used for links in emails and OAuth callbacks)
# In production: the real domain, e.g. NEXT_PUBLIC_APP_URL="https://tudominio.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Authentication (Better Auth)
# In production: generate a random secret with 32+ characters, e.g.
# `openssl rand -base64 32`. Keep it secret and stable across deploys.
BETTER_AUTH_SECRET=""

# Mercado Pago (pagos/checkout — slice 3)
# Sandbox: crear una app en developers.mercadopago.com.ar, generar credenciales
# de PRUEBA (test_user / test_merchant) y registrar la redirect_uri del OAuth
# callback. Los secrets solo se usan server-side; nunca exponerlos al cliente.
MP_ACCESS_TOKEN=""
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_WEBHOOK_SECRET=""