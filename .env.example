# PostgreSQL connection string (Supabase)
# In production: use the Supabase Pgbouncer pooler with sslmode=require, e.g.
# "postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# Public base URL of the app (used for links in emails and OAuth callbacks)
# In production: the real domain, e.g. NEXT_PUBLIC_APP_URL="https://tudominio.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Authentication (Better Auth)
# In production: generate a random secret with 32+ characters, e.g.
# `openssl rand -base64 32`. Keep it secret and stable across deploys.
BETTER_AUTH_SECRET=""