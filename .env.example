# PostgreSQL connection strings (Supabase). No agregues `sslmode`: el TLS se
# configura en el código (src/lib/db/prisma.ts) y la app lo ignora.
#
# DATABASE_URL: la usa la app. En Vercel (producción y preview) usá el
# TRANSACTION pooler (puerto 6543): comparte conexiones entre instancias. El
# SESSION pooler (5432) retiene una conexión por instancia y agota el cupo
# (error EMAXCONNSESSION, el sitio se cae).
# "postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
DATABASE_URL="postgresql://user:password@host:6543/postgres"

# DIRECT_URL: solo para `prisma migrate` (prisma.config.ts la prefiere si
# existe). Usá el SESSION pooler (puerto 5432): las migraciones no funcionan
# por el transaction pooler. Si falta, se usa DATABASE_URL.
# "postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Public base URL of the app (used for links in emails and OAuth callbacks)
# In production: the real domain, e.g. NEXT_PUBLIC_APP_URL="https://tudominio.com"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Authentication (Better Auth)
# In production: generate a random secret with 32+ characters, e.g.
# `openssl rand -base64 32`. Keep it secret and stable across deploys.
BETTER_AUTH_SECRET=""

# Mercado Pago (pagos/checkout — slice 3)
# Sandbox: crear una app en developers.mercadopago.com.ar, generar credenciales
# de PRUEBA (test_user / test_merchant) y registrar la redirect_uri del OAuth
# callback. Los secrets solo se usan server-side; nunca exponerlos al cliente.
MP_ACCESS_TOKEN=""
MP_CLIENT_ID=""
MP_CLIENT_SECRET=""
MP_WEBHOOK_SECRET=""

# Cron diario de pagos (/api/cron/pagos, ver vercel.json): renueva los tokens
# de Mercado Pago de los vendedores y reintenta los reembolsos pendientes.
# Vercel lo envía como "Authorization: Bearer <CRON_SECRET>". Generar un valor
# aleatorio de 32+ caracteres, p. ej. `openssl rand -base64 32`. Sin este
# valor la ruta rechaza todas las llamadas.
CRON_SECRET=""
